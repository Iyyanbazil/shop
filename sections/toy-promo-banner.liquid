<style>
  .tpb-outer-{{ section.id }} {
    padding: {{ section.settings.section_margin }}px 0;
  }

  @media screen and (max-width: 780px) {
    #toy-promo-banner-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    #toy-promo-banner-{{ section.id }} .tpb-left {
      display: none !important;
    }
  }

  #toy-promo-banner-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
    overflow: visible;
    border-radius: 0;
    box-sizing: border-box;
  }

  /* ── LEFT PANEL ── */
  #toy-promo-banner-{{ section.id }} .tpb-left {
    position: relative;
    min-height: {{ section.settings.panel_height }}px;
    background-color: {{ section.settings.left_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0;
  }

  #toy-promo-banner-{{ section.id }} .tpb-left-bg {
    position: absolute;
    inset: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  #toy-promo-banner-{{ section.id }} .tpb-left-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 55%;
    aspect-ratio: 331 / 178;
  }

  #toy-promo-banner-{{ section.id }} .tpb-left-content svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #toy-promo-banner-{{ section.id }} .tpb-left-heading-wrap {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 1rem 2rem;
  }

  #toy-promo-banner-{{ section.id }} .tpb-left-heading {
    font-size: {{ section.settings.left_heading_size }}px;
    font-weight: 800;
    line-height: 1.25;
    color: {{ section.settings.left_heading_color }};
    font-family: inherit;
    margin: 0;
  }

  /* ── RIGHT PANEL ── */
  #toy-promo-banner-{{ section.id }} .tpb-right {
    position: relative;
    min-height: {{ section.settings.panel_height }}px;
    background-color: {{ section.settings.right_bg_color }};
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: 0;
  }

  #toy-promo-banner-{{ section.id }} .tpb-right-bg {
    position: absolute;
    inset: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  #toy-promo-banner-{{ section.id }} .tpb-right-content {
    position: relative;
    z-index: 2;
    padding: 3rem 3.5rem;
    max-width: 55%;
    margin-left: auto;
  }

  #toy-promo-banner-{{ section.id }} .tpb-right-heading {
    font-size: {{ section.settings.right_heading_size }}px;
    font-weight: 800;
    line-height: 1.2;
    color: {{ section.settings.right_heading_color }};
    margin: 0 0 0.8rem;
  }

  #toy-promo-banner-{{ section.id }} .tpb-right-subtext {
    font-size: 1.4rem;
    color: {{ section.settings.right_subtext_color }};
    margin: 0 0 1.8rem;
    line-height: 1.5;
  }

  #toy-promo-banner-{{ section.id }} .tpb-btn {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: 1.1rem 2.8rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1.4rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  #toy-promo-banner-{{ section.id }} .tpb-btn:hover {
    opacity: 0.85;
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 749px) {
    .tpb-outer-{{ section.id }} {
      padding: 1rem 0;
    }

    #toy-promo-banner-{{ section.id }} {
      grid-template-columns: 1fr;
      border-radius: 0;
    }

    #toy-promo-banner-{{ section.id }} .tpb-left {
      min-height: 220px;
      border-radius: 0;
    }

    #toy-promo-banner-{{ section.id }} .tpb-right {
      min-height: 220px;
      border-radius: 0;
    }

    #toy-promo-banner-{{ section.id }} .tpb-left-content {
      width: 82%;
    }

    #toy-promo-banner-{{ section.id }} .tpb-left-heading {
      font-size: {{ section.settings.left_heading_size | times: 0.75 | round }}px;
    }

    #toy-promo-banner-{{ section.id }} .tpb-right-content {
      padding: 2rem;
      max-width: 70%;
      margin-left: auto;
    }

    #toy-promo-banner-{{ section.id }} .tpb-right-heading {
      font-size: {{ section.settings.right_heading_size | times: 0.7 | round }}px;
    }
  }
</style>

<div class="tpb-outer-{{ section.id }}">
<div class="page-width">
<div id="toy-promo-banner-{{ section.id }}">

  {%- comment -%} LEFT PANEL {%- endcomment -%}
  <div class="tpb-left">
    {%- if section.settings.left_bg_image != blank -%}
      {{
        section.settings.left_bg_image
        | image_url: width: 1200
        | image_tag: class: 'tpb-left-bg', loading: 'lazy', alt: section.settings.left_bg_image.alt
      }}
    {%- endif -%}
    <div class="tpb-left-content">
      <svg viewBox="0 0 331 178" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M326.14 144.826C326.14 144.826 324.201 166.159 271.406 176.808C250.486 181.03 63.0232 173.015 38.4722 168.821C-28.4512 157.389 6.52898 33.2706 34.4275 16.4099C62.326 -0.450655 192.328 -1.5599 240.857 1.1023C291.374 3.87542 320.605 18.8503 328.108 72.538C335.61 126.226 326.147 144.826 326.147 144.826H326.14Z" fill="white"/>
      </svg>
      <div class="tpb-left-heading-wrap">
        <p class="tpb-left-heading">{{ section.settings.left_heading | newline_to_br }}</p>
      </div>
    </div>
  </div>

  {%- comment -%} RIGHT PANEL {%- endcomment -%}
  <div class="tpb-right">
    {%- if section.settings.right_bg_image != blank -%}
      {{
        section.settings.right_bg_image
        | image_url: width: 1200
        | image_tag: class: 'tpb-right-bg', loading: 'lazy', alt: section.settings.right_bg_image.alt
      }}
    {%- endif -%}
    <div class="tpb-right-content">
      <h2 class="tpb-right-heading">{{ section.settings.right_heading }}</h2>
      {%- if section.settings.right_subtext != blank -%}
        <p class="tpb-right-subtext">{{ section.settings.right_subtext }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          class="tpb-btn"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

</div>
</div>
</div>

{% schema %}
{
  "name": "Toy Promo Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "panel_height",
      "min": 180,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Panel height",
      "default": 280
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "label": "Max width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section vertical margin",
      "default": 20
    },
    {
      "type": "header",
      "content": "Left panel"
    },
    {
      "type": "image_picker",
      "id": "left_bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Background colour (fallback)",
      "default": "#b8eaf5"
    },
    {
      "type": "textarea",
      "id": "left_heading",
      "label": "Heading text",
      "default": "Discover the\nJoy of Play"
    },
    {
      "type": "color",
      "id": "left_heading_color",
      "label": "Heading colour",
      "default": "#2b6cb0"
    },
    {
      "type": "range",
      "id": "left_heading_size",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 28
    },
    {
      "type": "header",
      "content": "Right panel"
    },
    {
      "type": "image_picker",
      "id": "right_bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "right_bg_color",
      "label": "Background colour (fallback)",
      "default": "#d4eef8"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Heading",
      "default": "Eco – Friendly Toys"
    },
    {
      "type": "color",
      "id": "right_heading_color",
      "label": "Heading colour",
      "default": "#1a6a8a"
    },
    {
      "type": "range",
      "id": "right_heading_size",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 30
    },
    {
      "type": "text",
      "id": "right_subtext",
      "label": "Subtext",
      "default": "Flash sale 30%, Extra discount for loyal customers"
    },
    {
      "type": "color",
      "id": "right_subtext_color",
      "label": "Subtext colour",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#f5c842"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Toy Promo Banner"
    }
  ]
}
{% endschema %}
