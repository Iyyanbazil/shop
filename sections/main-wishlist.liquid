{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .wishlist-page__heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 1.6rem;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .wishlist-page__title {
    font-size: 2.8rem;
    font-weight: 700;
    margin: 0;
  }

  .wishlist-page__subtitle {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.5);
    margin: 0;
  }

  .wishlist-items {
    display: flex;
    flex-direction: column;
  }

  .wishlist-item {
    display: grid;
    grid-template-columns: 9.6rem 1fr auto auto;
    align-items: center;
    gap: 2.4rem;
    padding: 2rem 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }

  .wishlist-item__image {
    width: 9.6rem;
    height: 9.6rem;
    border-radius: 0.8rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
    flex-shrink: 0;
  }

  .wishlist-item__image a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wishlist-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wishlist-item__info {
    min-width: 0;
  }

  .wishlist-item__title {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wishlist-item__title a {
    color: inherit;
    text-decoration: none;
  }

  .wishlist-item__title a:hover {
    text-decoration: underline;
  }

  .wishlist-item__price {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0;
    color: rgba(var(--color-foreground), 0.8);
  }

  .wishlist-item__actions {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-width: 15rem;
  }

  .wishlist-btn {
    display: block;
    width: 100%;
    padding: 1rem 1.8rem;
    font-size: 1.35rem;
    font-weight: 600;
    border-radius: 0.5rem;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, border-color 0.2s;
    font-family: inherit;
    border: 0.15rem solid transparent;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .wishlist-btn--cart {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-color: rgb(var(--color-button));
  }

  .wishlist-btn--cart:hover:not(:disabled) {
    opacity: 0.85;
  }

  .wishlist-btn--cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .wishlist-btn--buy {
    background: transparent;
    color: rgb(var(--color-foreground));
    border-color: rgba(var(--color-foreground), 0.25);
  }

  .wishlist-btn--buy:hover {
    border-color: rgb(var(--color-foreground));
  }

  .wishlist-item__remove {
    background: none;
    border: none;
    cursor: pointer;
    width: 3.6rem;
    height: 3.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground), 0.3);
    border-radius: 50%;
    transition: color 0.2s, background 0.2s;
    align-self: center;
    flex-shrink: 0;
  }

  .wishlist-item__remove:hover {
    color: #e8344a;
    background: rgba(232, 52, 74, 0.08);
  }

  .wishlist-empty {
    text-align: center;
    padding: 8rem 2rem;
  }

  .wishlist-empty__icon {
    display: block;
    font-size: 5rem;
    line-height: 1;
    margin-bottom: 2rem;
    color: rgba(var(--color-foreground), 0.15);
  }

  .wishlist-empty__title {
    font-size: 2.2rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .wishlist-empty__text {
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.55);
    margin: 0 0 2.4rem;
  }

  @media screen and (max-width: 749px) {
    .wishlist-item {
      grid-template-columns: 8rem 1fr auto;
      grid-template-rows: auto auto;
      gap: 1rem 1.4rem;
    }

    .wishlist-item__image {
      width: 8rem;
      height: 8rem;
      grid-row: 1 / 3;
    }

    .wishlist-item__info {
      grid-column: 2 / 3;
      grid-row: 1;
    }

    .wishlist-item__remove {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
    }

    .wishlist-item__actions {
      grid-column: 2 / 4;
      grid-row: 2;
      flex-direction: row;
      min-width: 0;
    }

    .wishlist-btn {
      flex: 1;
      padding: 0.9rem 1rem;
      font-size: 1.25rem;
    }
  }
</style>

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="wishlist-page__heading">
      <h1 class="wishlist-page__title">My Favourites</h1>
      <p class="wishlist-page__subtitle" id="wishlist-subtitle"></p>
    </div>

    <div id="wishlist-empty" class="wishlist-empty" style="display:none">
      <span class="wishlist-empty__icon">♡</span>
      <h2 class="wishlist-empty__title">Your favourites list is empty</h2>
      <p class="wishlist-empty__text">Save products you love and shop them anytime.</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">Continue Shopping</a>
    </div>

    <div id="wishlist-items" class="wishlist-items"></div>
  </div>
</div>

<script>
(function () {
  var STORAGE_KEY = 'shopify_wishlist';

  function getWishlist() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch (e) { return []; }
  }

  function saveWishlist(list) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch (e) {}
  }

  function removeFromWishlist(id) {
    saveWishlist(getWishlist().filter(function (item) { return String(item.id) !== String(id); }));
  }

  function esc(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fmtMoney(cents) {
    if (!cents) return '';
    return '$' + (Number(cents) / 100).toFixed(2);
  }

  function renderWishlist() {
    var items = getWishlist();
    var container = document.getElementById('wishlist-items');
    var emptyEl = document.getElementById('wishlist-empty');
    var subtitle = document.getElementById('wishlist-subtitle');

    if (!container) return;

    if (!items.length) {
      container.innerHTML = '';
      if (emptyEl) emptyEl.style.display = '';
      if (subtitle) subtitle.textContent = '';
      return;
    }

    if (emptyEl) emptyEl.style.display = 'none';
    if (subtitle) subtitle.textContent = '(' + items.length + (items.length === 1 ? ' item' : ' items') + ')';

    container.innerHTML = items.map(function (item) {
      var price = item.priceFormatted || fmtMoney(item.price);
      var imgHtml = item.image
        ? '<img src="' + esc(item.image) + '" alt="' + esc(item.title) + '" loading="lazy">'
        : '';

      return [
        '<div class="wishlist-item" data-id="' + esc(item.id) + '">',
          '<div class="wishlist-item__image">',
            '<a href="' + esc(item.url) + '">' + imgHtml + '</a>',
          '</div>',
          '<div class="wishlist-item__info">',
            '<h3 class="wishlist-item__title"><a href="' + esc(item.url) + '">' + esc(item.title) + '</a></h3>',
            price ? '<p class="wishlist-item__price">' + esc(price) + '</p>' : '',
          '</div>',
          '<div class="wishlist-item__actions">',
            '<button class="wishlist-btn wishlist-btn--cart" data-action="add-cart" data-variant="' + esc(item.variantId) + '">Add to Cart</button>',
            '<a href="' + esc(item.url) + '" class="wishlist-btn wishlist-btn--buy">Buy Now</a>',
          '</div>',
          '<button class="wishlist-item__remove" data-action="remove" data-id="' + esc(item.id) + '" aria-label="Remove from favourites">',
            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
          '</button>',
        '</div>'
      ].join('');
    }).join('');
  }

  async function handleAddToCart(variantId, btn) {
    if (!variantId) return;
    btn.disabled = true;
    var orig = btn.textContent;
    btn.textContent = 'Adding…';

    try {
      var cartNotification = document.querySelector('cart-notification');
      var cartDrawer = document.querySelector('cart-drawer');
      var cartHandler = cartNotification || cartDrawer;
      var sections = cartHandler
        ? cartHandler.getSectionsToRender().map(function (s) { return s.id; })
        : [];

      var res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          id: Number(variantId),
          quantity: 1,
          sections: sections,
          sections_url: window.location.pathname
        })
      });

      if (!res.ok) throw new Error('cart-add-failed');
      var data = await res.json();

      if (cartHandler && data.sections) {
        cartHandler.renderContents(data);
      } else if (cartHandler && cartHandler.open) {
        cartHandler.open(btn);
      }

      btn.textContent = '✓ Added';
      setTimeout(function () { btn.textContent = orig; btn.disabled = false; }, 1800);
    } catch (_) {
      btn.textContent = orig;
      btn.disabled = false;
    }
  }

  document.addEventListener('click', function (e) {
    var removeBtn = e.target.closest('[data-action="remove"]');
    if (removeBtn) {
      removeFromWishlist(removeBtn.dataset.id);
      if (window.WishlistManager) {
        window.WishlistManager.updateHeartButtons();
        window.WishlistManager.updateWishlistCount();
      }
      renderWishlist();
      return;
    }

    var cartBtn = e.target.closest('[data-action="add-cart"]');
    if (cartBtn) handleAddToCart(cartBtn.dataset.variant, cartBtn);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderWishlist);
  } else {
    renderWishlist();
  }

  window.addEventListener('storage', function (e) {
    if (e.key === STORAGE_KEY) renderWishlist();
  });

  window.WishlistPage = { render: renderWishlist };
})();
</script>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
