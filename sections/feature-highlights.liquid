{%- style -%}
  .feature-highlights {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .feature-highlights__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 20px;
  }

  .feature-highlights__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 24px;
    border-radius: 16px;
  }

  .feature-highlights__icon {
    width: 64px;
    height: 64px;
    margin-bottom: 14px;
    object-fit: contain;
  }

  .feature-highlights__title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .feature-highlights__desc {
    font-size: 0.9rem;
    color: #555;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .feature-highlights__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="feature-highlights page-width">
  <div class="feature-highlights__grid">
    {%- for block in section.blocks -%}
      <div
        class="feature-highlights__card"
        style="background-color: {{ block.settings.card_bg_color }};"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.icon != blank -%}
          <img
            class="feature-highlights__icon"
            src="{{ block.settings.icon | image_url: width: 128 }}"
            alt="{{ block.settings.title }}"
            loading="lazy"
            width="64"
            height="64"
          >
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <p class="feature-highlights__title" style="color: {{ block.settings.title_color }};">
            {{ block.settings.title }}
          </p>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <p class="feature-highlights__desc">{{ block.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature Highlights",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#1096b5"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short description here"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background color",
          "default": "#edf6ff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Customer care",
            "title_color": "#1096b5",
            "description": "24h hour follow up",
            "card_bg_color": "#edf6ff"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free ship",
            "title_color": "#e07b2a",
            "description": "Free shipping for 150$ and up",
            "card_bg_color": "#fff5ec"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Return",
            "title_color": "#2a9e5c",
            "description": "Within 7 days",
            "card_bg_color": "#edfaf3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
