{%- style -%}
  .recent-photoshoots {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .recent-photoshoots__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .recent-photoshoots__heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 0.4rem;
    font-family: inherit;
  }

  .recent-photoshoots__subheading {
    font-size: 1rem;
    color: #666;
    margin: 0;
  }

  .recent-photoshoots__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .recent-photoshoots__item {
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
  }

  .recent-photoshoots__item img {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .recent-photoshoots__item:hover img {
    transform: scale(1.05);
  }

  @media screen and (max-width: 749px) {
    .recent-photoshoots__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .recent-photoshoots__grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }
{%- endstyle -%}

<div class="recent-photoshoots">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="recent-photoshoots__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="recent-photoshoots__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="recent-photoshoots__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="recent-photoshoots__grid">
    {%- for block in section.blocks -%}
      <div class="recent-photoshoots__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Recent Photoshoots",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent photoshoots"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Check gallery"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 150,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 300
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between images",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recent Photoshoots",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
