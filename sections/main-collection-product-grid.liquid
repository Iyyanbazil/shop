{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | plus: 30 }}px;
    }
  }

  .sidebar-widget {
    padding: 16px;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    background: #fff;
    margin-bottom: 16px;
  }

  .sidebar-widget__title {
    font-size: 1.6rem;
    font-weight: 600;
    color: #222;
    margin: 0 0 14px;
  }

  /* Add border card styling to each vertical facet filter group */
  .facets__disclosure-vertical {
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    background: #fff;
    margin-bottom: 16px;
    padding: 16px;
    overflow: hidden;
  }

  .facets__disclosure-vertical > summary {
    padding: 0;
    list-style: none;
  }

  .sidebar-categories__list {
    padding: 0;
    margin: 0;
  }

  .sidebar-categories__item {
    margin-bottom: 8px;
  }

  .sidebar-categories__link {
    font-size: 1.4rem;
    color: #333;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .sidebar-categories__link:hover,
  .sidebar-categories__item.active .sidebar-categories__link {
    color: #1a9cbf;
  }

  .sidebar-popular-product {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
    align-items: center;
  }

  .sidebar-popular-product:last-child {
    margin-bottom: 0;
  }

  .sidebar-popular-product__image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .sidebar-popular-product__info {
    flex: 1;
    min-width: 0;
  }

  .sidebar-popular-product__title {
    font-size: 1.3rem;
    color: #333;
    text-decoration: none;
    display: block;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .sidebar-popular-product__title:hover {
    color: #1a9cbf;
  }

  .sidebar-popular-product__price {
    font-size: 1.4rem;
    color: #1a9cbf;
    font-weight: 600;
    margin: 0;
  }

  /* Price range slider */
  .facets__price {
    display: block !important;
    padding: 0 !important;
  }

  .price-range-ui {
    padding: 4px 0 0;
  }

  .price-range-ui__slider-wrap {
    position: relative;
    height: 30px;
    display: flex;
    align-items: center;
    margin: 14px 0 12px;
    padding: 0 10px;
  }

  .price-range-ui__track {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(
      to right,
      #d8d8d8 var(--pf-min, 0%),
      #1a9cbf var(--pf-min, 0%),
      #1a9cbf var(--pf-max, 100%),
      #d8d8d8 var(--pf-max, 100%)
    );
  }

  .price-range-ui__fill {
    display: none;
  }

  .price-range-ui__input {
    -webkit-appearance: none;
    appearance: none;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    height: 6px;
    background: transparent;
    outline: none;
    pointer-events: none;
    margin: 0;
    padding: 0;
  }

  .price-range-ui__input::-webkit-slider-runnable-track {
    background: transparent;
    height: 6px;
  }

  .price-range-ui__input::-moz-range-track {
    background: transparent;
    height: 6px;
  }

  .price-range-ui__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    background: #1a9cbf;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: all;
    box-shadow: 0 1px 4px rgba(0,0,0,0.18);
    margin-top: -7px;
  }

  .price-range-ui__input::-moz-range-thumb {
    width: 20px;
    height: 20px;
    background: #1a9cbf;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: all;
    border: none;
    box-shadow: 0 1px 4px rgba(0,0,0,0.18);
  }

  .price-range-ui__values {
    display: flex;
    justify-content: space-between;
    font-size: 1.4rem;
    color: #444;
    margin-bottom: 16px;
    font-weight: 500;
  }

  .price-range-ui__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }

  .price-range-ui__apply {
    background: #1a9cbf;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    letter-spacing: 0.02em;
  }

  .price-range-ui__apply:hover {
    background: #1485a3;
  }

  /* Padding for price slider inside mobile drawer */
  .mobile-facets__submenu .price-range-ui {
    padding: 0 1.6rem 1.6rem;
  }

  /* Hide duplicate inner Apply button inside mobile price submenu */
  .mobile-facets__submenu .price-range-ui__footer {
    display: none;
  }

  /* Mobile filter — increase font size */
  .mobile-facets__label,
  .mobile-facets__summary,
  .mobile-facets__heading,
  .mobile-facets__item label,
  .mobile-facets__item a {
    font-size: 1.8rem !important;
  }

  /* Mobile filter Apply buttons — teal primary color */
  .mobile-facets__apply-btn {
    background-color: #1a9cbf !important;
    color: #fff !important;
    border-color: #1a9cbf !important;
    border-radius: 0.6rem;
  }
  .mobile-facets__apply-btn:hover {
    background-color: #1485a3 !important;
    border-color: #1485a3 !important;
  }

  /* Sidebar gap */
  .facets-vertical .facets-wrapper {
    padding-right: 5rem !important;
  }

  /* Increase product grid gap */
  #product-grid {
    --grid-desktop-horizontal-spacing: 20px;
    --grid-desktop-vertical-spacing: 28px;
  }

  @media screen and (max-width: 749px) {
    #product-grid {
      --grid-mobile-horizontal-spacing: 12px;
      --grid-mobile-vertical-spacing: 20px;
    }
  }

  /* Product grid responsive columns */
  @media screen and (min-width: 500px) and (max-width: 750px) {
    #product-grid .grid__item {
      width: calc(33.33% - var(--grid-mobile-horizontal-spacing) * 2 / 3) !important;
    }
  }

  @media screen and (min-width: 350px) and (max-width: 499px) {
    #product-grid .grid__item {
      width: calc(50% - var(--grid-mobile-horizontal-spacing) / 2) !important;
    }
  }

  @media screen and (max-width: 349px) {
    #product-grid .grid__item {
      width: 100% !important;
      max-width: 100% !important;
    }
  }

  /* Pagination */
  .pagination-wrapper {
    margin-top: 3rem;
  }

  .pagination__list {
    gap: 8px;
  }

  .pagination__list > li {
    flex: 0 0 auto;
    max-width: none;
    margin-right: 0 !important;
  }

  .pagination__item {
    width: 40px !important;
    height: 40px !important;
    border-radius: 50% !important;
    border: 1.5px solid #d8d8d8 !important;
    background: #fff !important;
    color: #333 !important;
    font-size: 1.4rem !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    transition: border-color 0.2s, background 0.2s, color 0.2s !important;
  }

  .pagination__item::after {
    display: none !important;
  }

  .pagination__item:hover:not(.pagination__item--current) {
    border-color: #1a9cbf !important;
    color: #1a9cbf !important;
  }

  .pagination__item--current {
    background: #1a9cbf !important;
    border-color: #1a9cbf !important;
    color: #fff !important;
    font-weight: 700 !important;
  }

  .pagination__item-arrow {
    border: 1.5px solid #d8d8d8 !important;
    background: #fff !important;
    color: #333 !important;
  }

  .pagination__item-arrow:hover {
    border-color: #1a9cbf !important;
    color: #1a9cbf !important;
  }

  .pagination__item-arrow .icon-caret {
    width: 10px !important;
    height: 10px !important;
  }

  .pagination__item--next .icon-caret {
    transform: rotate(90deg) !important;
  }

  .pagination__item--prev .icon-caret {
    transform: rotate(-90deg) !important;
  }

  /* Rating stars */
  .card-wrapper .rating-star {
    --color-rating-star: #f5a623;
    --font-size: 2.6;
    --letter-spacing: 0.7;
  }

  .card-rating-row {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .card-rating-row .rating-count {
    font-size: 1.3rem;
    color: #666;
    margin: 0;
  }

  /* Breadcrumb */
  .collection-breadcrumb {
    font-size: 1.8rem;
    color: #999;
    padding: 4px 0 0;
    margin-bottom: 30px;
  }

  .collection-breadcrumb a {
    color: #999;
    text-decoration: none;
  }

  .collection-breadcrumb a:hover {
    color: #1a9cbf;
  }

  .collection-breadcrumb__separator {
    margin: 0 6px;
  }

  .collection-breadcrumb__current {
    color: #1a9cbf;
    font-weight: 600;
  }

  .facets-vertical-sort:not(.page-width) {
    width: 100%;
    margin-bottom: 16px;
  }

  /* Collection page title above products */
  .collection-page-title {
    font-size: 3.6rem;
    font-weight: 700;
    margin: 0 0 16px;
    color: #111;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .collection-page-title {
      margin-top: 20px;
    }
  }

  /* Grid / List view toggle */
  .view-toggle {
    display: flex;
    gap: 5px;
    align-items: center;
    margin-right: 10px;
  }

  .view-toggle__btn {
    background: none;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 5px 7px;
    cursor: pointer;
    color: #888;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    line-height: 1;
  }

  .view-toggle__btn.active,
  .view-toggle__btn:hover {
    background: #1a9cbf;
    border-color: #1a9cbf;
    color: #fff;
    position: relative;
    z-index: 1;
  }

  .cst-sort-bar {
    display: block;
    width: 100%;
    margin-bottom: 16px;
  }

  .cst-sort-form {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0;
    margin: 0;
  }

  .cst-sort-left {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    margin: 0;
  }

  .cst-sort-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .cst-sort-select {
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: transparent;
    padding: 6px 28px 6px 4px;
    font-size: 1.4rem;
    color: #333;
    cursor: pointer;
    outline: none;
  }

  .cst-sort-caret {
    position: absolute;
    right: 10px;
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .cst-sort-caret svg,
  .cst-sort-caret .svg-wrapper {
    width: 10px;
    height: 10px;
  }

  .cst-sort-bar .product-count-vertical {
    flex-shrink: 0;
    padding: 0;
    margin: 0;
  }

  /* Hidden by default — shown only in list view */
  .card__description,
  .card__list-actions {
    display: none;
  }

  /* List view: force single column stack */
  #product-grid.list-view {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
  }

  #product-grid.list-view .grid__item {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Ensure wrapper elements don't shrink card */
  #product-grid.list-view product-component,
  #product-grid.list-view .card-wrapper {
    display: block !important;
    width: 100% !important;
  }

  /* Card becomes a horizontal row */
  #product-grid.list-view .card {
    display: flex !important;
    flex-direction: row !important;
    min-height: 180px;
    border: 1px solid #e8e8e8 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
  }

  /* Image column: fixed square */
  #product-grid.list-view .card__inner {
    width: 200px !important;
    min-width: 200px !important;
    flex-shrink: 0 !important;
    padding-bottom: 0 !important;
    height: 200px !important;
    position: relative !important;
    overflow: hidden !important;
    border-radius: 0 !important;
  }

  #product-grid.list-view .card__media {
    position: absolute !important;
    inset: 0 !important;
    height: 100% !important;
  }

  #product-grid.list-view .card__media img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
  }

  /* Hide overlay buttons and inner duplicate title */
  #product-grid.list-view .card__actions-overlay,
  #product-grid.list-view .card__inner .card__content {
    display: none !important;
  }

  /* Content column */
  #product-grid.list-view .card > .card__content {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    flex: 1 !important;
    padding: 20px 24px !important;
    gap: 6px;
  }

  /* Hide grid-only quick-add in list view */
  #product-grid.list-view .quick-add {
    display: none !important;
  }

  /* Show description in list view */
  #product-grid.list-view .card__description {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 1.3rem;
    color: #666;
    line-height: 1.5;
    margin: 2px 0 6px;
  }

  /* Show action buttons in list view */
  #product-grid.list-view .card__list-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  .card__list-cart-btn {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #1a9cbf;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .card__list-cart-btn:hover:not(:disabled) {
    background: #0d7f9a;
  }

  .card__list-cart-btn--sold-out,
  .card__list-cart-btn:disabled {
    background: #aaa;
    cursor: not-allowed;
  }

  .card__list-cart-btn svg {
    width: 16px;
    height: 16px;
    stroke: #fff;
    flex-shrink: 0;
  }

  .card__list-action-btn {
    position: relative;
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #555;
    transition: all 0.2s;
  }

  .card__list-action-btn:hover {
    border-color: #1a9cbf;
    color: #1a9cbf;
  }
{%- endstyle -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.filter_type == 'vertical' -%}
        <div class="page-width">
          <nav class="collection-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="collection-breadcrumb__separator">/</span>
            {%- if collection.handle == 'all' -%}
              <span class="collection-breadcrumb__current" aria-current="page">Products</span>
            {%- else -%}
              <a href="{{ routes.all_products_collection_url }}">Products</a>
              <span class="collection-breadcrumb__separator">/</span>
              <span class="collection-breadcrumb__current" aria-current="page">{{ collection.title }}</span>
            {%- endif -%}
          </nav>
        </div>
      {%- endif -%}


      <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {%- if section.settings.filter_type == 'vertical' -%}
              <div class="sidebar-widget sidebar-categories small-hide">
                <h3 class="sidebar-widget__title">Product categories</h3>
                <ul class="sidebar-categories__list list-unstyled">
                  {%- if section.settings.categories_menu != blank -%}
                    {%- assign cat_menu = linklists[section.settings.categories_menu] -%}
                    {%- for link in cat_menu.links -%}
                      <li class="sidebar-categories__item{% if link.active %} active{% endif %}">
                        <a href="{{ link.url }}" class="sidebar-categories__link">
                          <span>+</span> {{ link.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for col in collections -%}
                      {%- unless col.handle == 'frontpage' or col.handle == 'all' -%}
                        <li class="sidebar-categories__item{% if col.handle == collection.handle %} active{% endif %}">
                          <a href="{{ col.url }}" class="sidebar-categories__link">
                            <span>+</span> {{ col.title }}
                          </a>
                        </li>
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}

            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              paginate: paginate
            %}

            {%- if section.settings.filter_type == 'vertical' and section.settings.show_popular_products and section.settings.popular_products_collection != blank -%}
              {%- assign pop_coll = collections[section.settings.popular_products_collection] -%}
              {%- if pop_coll != blank and pop_coll.products_count > 0 -%}
                <div class="sidebar-widget sidebar-popular-products small-hide">
                  <h3 class="sidebar-widget__title">Popular products</h3>
                  {%- for product in pop_coll.products limit: 3 -%}
                    <div class="sidebar-popular-product">
                      <a href="{{ product.url }}" class="sidebar-popular-product__image-link">
                        {%- if product.featured_image -%}
                          <img
                            src="{{ product.featured_image | image_url: width: 100 }}"
                            alt="{{ product.featured_image.alt | escape }}"
                            width="60"
                            height="60"
                            loading="lazy"
                            class="sidebar-popular-product__image"
                          >
                        {%- endif -%}
                      </a>
                      <div class="sidebar-popular-product__info">
                        <a href="{{ product.url }}" class="sidebar-popular-product__title">{{ product.title | truncate: 30 }}</a>
                        <p class="sidebar-popular-product__price">{{ product.price | money }}</p>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </aside>
        {%- endif -%}

        <div
          class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          id="ProductGridContainer"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if section.settings.filter_type == 'vertical' -%}
            <h1 class="collection-page-title">{{ collection.title }}</h1>
          {%- endif -%}

          {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
            <facet-filters-form class="cst-sort-bar small-hide">
              <form class="cst-sort-form" id="FacetSortForm">
                <div class="cst-sort-left">
                  <div class="view-toggle" id="ViewToggle">
                    <button type="button" class="view-toggle__btn active" data-view="grid" title="Grid view">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
                    </button>
                    <button type="button" class="view-toggle__btn" data-view="list" title="List view">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="14" height="3" rx="1"/><rect x="1" y="7" width="14" height="3" rx="1"/><rect x="1" y="12" width="14" height="3" rx="1"/></svg>
                    </button>
                  </div>
                  <div class="cst-sort-select-wrap">
                    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                    <select
                      name="sort_by"
                      class="cst-sort-select"
                      id="SortBy"
                      aria-describedby="a11y-refresh-page-message"
                    >
                      {%- for option in collection.sort_options -%}
                        <option
                          value="{{ option.value | escape }}"
                          {% if option.value == sort_by %}
                            selected="selected"
                          {% endif %}
                        >
                          {{ option.name | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                    <span class="cst-sort-caret">
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </span>
                  </div>
                </div>

                <div class="product-count-vertical light" role="status">
                  <h2 class="product-count__text text-body">
                    <span id="ProductCountDesktop">
                      {%- if collection.results_count -%}
                        {{
                          'templates.search.results_with_count'
                          | t: terms: collection.terms, count: collection.results_count
                        }}
                      {%- elsif collection.products_count == collection.all_products_count -%}
                        {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                      {%- else -%}
                        {{
                          'products.facets.product_count'
                          | t: product_count: collection.products_count, count: collection.all_products_count
                        }}
                      {%- endif -%}
                    </span>
                  </h2>
                  {%- render 'loading-spinner' -%}
                </div>
              </form>
            </facet-filters-form>
          {%- endif -%}

          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: collection.url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="
                  grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                  grid--{{ section.settings.columns_desktop }}-col-desktop
                  {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
                "
              >
                {% assign skip_card_product_styles = false %}
                {%- for product in collection.products -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      lazy_load: lazy_load,
                      skip_styles: skip_card_product_styles,
                      quick_add: section.settings.quick_add,
                      section_id: section.id,
                      product_view_context: 'collection'
                    %}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</collection-component>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var toggle = document.getElementById('ViewToggle');
    if (!toggle) return;
    var btns = toggle.querySelectorAll('.view-toggle__btn');
    var grid = document.getElementById('product-grid');
    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        if (grid) {
          if (btn.dataset.view === 'list') {
            grid.classList.add('list-view');
          } else {
            grid.classList.remove('list-view');
          }
        }
      });
    });
  });

  document.addEventListener('click', async function(e) {
    var btn = e.target.closest('.card__list-cart-btn');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    var variantId = btn.dataset.variantId;
    if (!variantId) return;
    try {
      var cartNotification = document.querySelector('cart-notification');
      var cartDrawer = document.querySelector('cart-drawer');
      var cartHandler = cartNotification || cartDrawer;
      var sections = cartHandler ? cartHandler.getSectionsToRender().map(function(s) { return s.id; }) : [];
      var response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(variantId), quantity: 1, sections: sections, sections_url: window.location.pathname })
      });
      if (!response.ok) return;
      var data = await response.json();
      if (cartHandler && data.sections) { cartHandler.renderContents(data); }
      else if (cartHandler) { cartHandler.open(btn); }
    } catch(err) { console.error('List cart error:', err); }
  }, true);
</script>

