<style>
  /* ── Judge.me carousel card background image ── */
  .jdgm-carousel-item,
  .jdgm-carousel__item {
    {%- if section.settings.card_bg_image != blank -%}
    background-image: url('{{ section.settings.card_bg_image | image_url: width: 800 }}') !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    background-color: transparent !important;
    {%- else -%}
    background-color: #FFF0F2 !important;
    {%- endif -%}
  }

  /* ── Stars: force gold colour and push to top of card ── */
  .jdgm-carousel-item .jdgm-rev__rating,
  .jdgm-carousel__item .jdgm-rev__rating {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    order: -1 !important;
    margin-bottom: 0.5rem;
  }

  /* filled stars */
  .jdgm-carousel-item .jdgm-star--on,
  .jdgm-carousel__item .jdgm-star--on,
  .jdgm-carousel-item [class*="jdgm-star"][class*="on"],
  .jdgm-carousel__item [class*="jdgm-star"][class*="on"] {
    color: #F5A623 !important;
    fill: #F5A623 !important;
  }

  /* half and empty stars */
  .jdgm-carousel-item .jdgm-star--half,
  .jdgm-carousel__item .jdgm-star--half {
    color: #F5A623 !important;
  }
  .jdgm-carousel-item .jdgm-star--off,
  .jdgm-carousel__item .jdgm-star--off {
    color: #e0c8a0 !important;
  }

  /* catch SVG-based star icons */
  .jdgm-carousel-item .jdgm-rev__rating svg,
  .jdgm-carousel__item .jdgm-rev__rating svg,
  .jdgm-carousel-item .jdgm-rev__rating svg path,
  .jdgm-carousel__item .jdgm-rev__rating svg path {
    fill: #F5A623 !important;
    color: #F5A623 !important;
  }

  /* flex-column on the review wrapper so order on rating takes effect,
     WITHOUT touching inline star icon elements */
  .jdgm-carousel-item .jdgm-rev,
  .jdgm-carousel__item .jdgm-rev {
    display: flex !important;
    flex-direction: column !important;
  }
</style>

{%- if section.settings.heading != blank or section.settings.subheading != blank -%}
  <div class="apps-section-header page-width" style="text-align: center; margin-bottom: 2rem;">
    {%- if section.settings.heading != blank -%}
      <h2 class="apps-section-heading" style="font-size: {{ section.settings.heading_size }}px; font-weight: 700; margin: 0 0 0.5rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="apps-section-subheading" style="color: #888; font-size: 1rem; margin: 0;">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "card_bg_image",
      "label": "Card background image"
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}
