{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .top-picks-section {
    padding: 5rem 0 4rem;
    background: #ffffff;
    text-align: center;
  }

  .top-picks__heading {
    font-size: 2.8rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 2.2rem;
  }

  .top-picks__tabs {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .top-picks__tab {
    padding: 0.55rem 1.8rem;
    border-radius: 50px;
    border: none;
    background: transparent;
    font-size: 1.5rem;
    font-weight: 500;
    color: #555555;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    line-height: 1.4;
  }

  .top-picks__tab:hover {
    color: #1a1a1a;
  }

  .top-picks__tab.is-active {
    background: #EDE9F8;
    color: #1a1a1a;
    font-weight: 600;
  }

  .top-picks__panel {
    display: none;
  }

  .top-picks__panel.is-active {
    display: block;
  }

  .top-picks__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: left;
  }

  @media screen and (max-width: 989px) {
    .top-picks__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .top-picks-section {
      padding: 3rem 1.5rem;
    }

    .top-picks__heading {
      font-size: 2.2rem;
    }

    .top-picks__tabs {
      margin-bottom: 2rem;
    }

    .top-picks__tab {
      font-size: 1.4rem;
      padding: 0.5rem 1.4rem;
    }
  }
</style>

<div class="top-picks-section{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="top-picks__heading">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="top-picks__tabs" role="tablist" aria-label="{{ section.settings.title | escape }}">
      <button
        class="top-picks__tab is-active"
        role="tab"
        aria-selected="true"
        aria-controls="top-picks-featured-{{ section.id }}"
        data-top-picks-tab="{{ section.id }}"
        data-target="top-picks-featured-{{ section.id }}"
      >
        {{ section.settings.tab_1_label }}
      </button>
      <button
        class="top-picks__tab"
        role="tab"
        aria-selected="false"
        aria-controls="top-picks-bestseller-{{ section.id }}"
        data-top-picks-tab="{{ section.id }}"
        data-target="top-picks-bestseller-{{ section.id }}"
      >
        {{ section.settings.tab_2_label }}
      </button>
      <button
        class="top-picks__tab"
        role="tab"
        aria-selected="false"
        aria-controls="top-picks-newarrivals-{{ section.id }}"
        data-top-picks-tab="{{ section.id }}"
        data-target="top-picks-newarrivals-{{ section.id }}"
      >
        {{ section.settings.tab_3_label }}
      </button>
    </div>

    {%- liquid
      assign products_limit = section.settings.products_to_show
    -%}

    <div
      class="top-picks__panel is-active"
      id="top-picks-featured-{{ section.id }}"
      role="tabpanel"
    >
      <div class="top-picks__grid">
        {%- if section.settings.featured_collection != blank -%}
          {%- assign skip_styles = false -%}
          {%- for product in section.settings.featured_collection.products limit: products_limit -%}
            <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: section.settings.show_rating,
                lazy_load: true,
                skip_styles: skip_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add
              %}
            </div>
            {%- assign skip_styles = true -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
              <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
                {% render 'card-product', placeholder_image: placeholder_image, media_aspect_ratio: 'adapt', skip_styles: false %}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
            <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
              {% render 'card-product', placeholder_image: placeholder_image, media_aspect_ratio: 'adapt', skip_styles: false %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div
      class="top-picks__panel"
      id="top-picks-bestseller-{{ section.id }}"
      role="tabpanel"
    >
      <div class="top-picks__grid">
        {%- if section.settings.bestseller_collection != blank -%}
          {%- assign skip_styles = false -%}
          {%- for product in section.settings.bestseller_collection.products limit: products_limit -%}
            <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: section.settings.show_rating,
                lazy_load: true,
                skip_styles: skip_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add
              %}
            </div>
            {%- assign skip_styles = true -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
              <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
                {% render 'card-product', placeholder_image: placeholder_image, media_aspect_ratio: 'adapt', skip_styles: false %}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
            <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
              {% render 'card-product', placeholder_image: placeholder_image, media_aspect_ratio: 'adapt', skip_styles: false %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div
      class="top-picks__panel"
      id="top-picks-newarrivals-{{ section.id }}"
      role="tabpanel"
    >
      <div class="top-picks__grid">
        {%- if section.settings.new_arrivals_collection != blank -%}
          {%- assign skip_styles = false -%}
          {%- for product in section.settings.new_arrivals_collection.products limit: products_limit -%}
            <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: false,
                show_rating: section.settings.show_rating,
                lazy_load: true,
                skip_styles: skip_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add
              %}
            </div>
            {%- assign skip_styles = true -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
              <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
                {% render 'card-product', placeholder_image: placeholder_image, media_aspect_ratio: 'adapt', skip_styles: false %}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- assign placeholder_image = 'product-apparel-' | append: forloop.index -%}
            <div {% if settings.animations_reveal_on_scroll %}class="scroll-trigger animate--slide-in" style="--animation-order: {{ forloop.index }};"{% endif %}>
              {% render 'card-product', placeholder_image: placeholder_image, media_aspect_ratio: 'adapt', skip_styles: false %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var tabs = document.querySelectorAll('[data-top-picks-tab="{{ section.id }}"]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        var targetId = tab.getAttribute('data-target');
        var panels = document.querySelectorAll('#top-picks-featured-{{ section.id }}, #top-picks-bestseller-{{ section.id }}, #top-picks-newarrivals-{{ section.id }}');
        panels.forEach(function (panel) {
          panel.classList.remove('is-active');
        });
        var target = document.getElementById(targetId);
        if (target) target.classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Top Picks",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Top picks for your little ones"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "Tab 1 Label",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Tab 1 Collection"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "Tab 2 Label",
      "default": "Best seller"
    },
    {
      "type": "collection",
      "id": "bestseller_collection",
      "label": "Tab 2 Collection"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "Tab 3 Label",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "new_arrivals_collection",
      "label": "Tab 3 Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8,
      "label": "Products to show per tab"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "none",
      "options": [
        { "value": "none", "label": "No button" },
        { "value": "standard", "label": "Quick add button" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Picks"
    }
  ]
}
{% endschema %}
