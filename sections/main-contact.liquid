{{ 'contact-page.css' | asset_url | stylesheet_tag }}

<div class="page-width contact-page">

  <!-- Breadcrumb -->
  <nav class="contact-breadcrumb" aria-label="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Contact</span>
  </nav>

  <!-- Page title -->
  <h1 class="contact-page-title">Contact</h1>

  <!-- Info cards -->
  <div class="contact-info-cards">
    <div class="contact-info-card">
      <div class="contact-info-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.58 3.47 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6.29 6.29l.89-.89a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </div>
      <p class="contact-info-card__label">Phone number</p>
      <p class="contact-info-card__value">{{ section.settings.phone | default: '123-456-7868' }}</p>
    </div>

    <div class="contact-info-card">
      <div class="contact-info-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>
      <p class="contact-info-card__label">Email</p>
      <p class="contact-info-card__value">{{ section.settings.email | default: 'info@example.com' }}</p>
    </div>

    <div class="contact-info-card">
      <div class="contact-info-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <p class="contact-info-card__label">Address place</p>
      <p class="contact-info-card__value">{{ section.settings.address | default: '1930 Marigold lane, way Miami, Florida USA' }}</p>
    </div>
  </div>

  <!-- Map + Form -->
  <div class="contact-main">

    <!-- Map -->
    <div class="contact-map">
      <iframe
        src="{{ section.settings.map_embed_url | default: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d114989.32586215671!2d-80.29944085!3d25.7616798!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9b0a20ec8c111%3A0xff96f271ddad4f65!2sMiami%2C%20FL%2C%20USA!5e0!3m2!1sen!2s!4v1696000000000' }}"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Store location map"
      ></iframe>
    </div>

    <!-- Contact form card -->
    <div class="contact-form-card">
      <h2 class="contact-form-title">Contact Us</h2>

      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form-status contact-form-status--success">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            {{ 'templates.contact.form.post_success' | t }}
          </div>
        {%- elsif form.errors -%}
          <div class="contact-form-status contact-form-status--error">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            {{ 'templates.contact.form.error_heading' | t }}
          </div>
        {%- endif -%}

        <div class="contact-field">
          <input
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="Your name"
            autocomplete="name"
          >
        </div>

        <div class="contact-field">
          <input
            type="tel"
            id="ContactForm-phone"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="Phone number"
            autocomplete="tel"
            pattern="[0-9\-]*"
          >
        </div>

        <div class="contact-field">
          <input
            type="email"
            id="ContactForm-email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="Email address"
            autocomplete="email"
            aria-required="true"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
        </div>

        <div class="contact-field">
          <textarea
            id="ContactForm-body"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            placeholder="Write your comment here..."
            rows="5"
          >{{- form.body -}}</textarea>
        </div>

        <button type="submit" class="contact-submit">Send</button>
      {%- endform -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "123-456-7868"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "info@example.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "1930 Marigold lane, way Miami, Florida USA"
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "Google Maps embed URL",
      "info": "Paste the src URL from a Google Maps embed code"
    }
  ]
}
{% endschema %}
